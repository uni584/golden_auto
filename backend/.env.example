MONGO_URL=replace-with-local-mongo-url
DB_NAME=golden_auto
JWT_SECRET=replace-with-local-dev-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-local-admin-password

# Dev/staging only smoke endpoint for Supabase token verification
SUPABASE_AUTH_CHECK_ENABLED=false

# Feature-flagged read-only customers path (default off)
SUPABASE_READONLY_CUSTOMERS_ENABLED=false
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_CUSTOMERS_TIMEOUT_SEC=5

# Optional example value for local CORS configuration
CORS_ORIGINS=http://localhost:3000
